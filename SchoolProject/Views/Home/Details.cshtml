@model News

<style>
    .course-content {
        font-size: 1.1rem;
        line-height: 1.7;
    }

        .course-content img {
            max-width: 100%;
            height: auto;
            margin: 1rem 0;
            border-radius: 4px;
        }

    .news-image {
        width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }

    .comments-list {
        max-height: 500px;
        overflow-y: auto;
    }

    .comment-item:last-child {
        border-bottom: none !important;
    }
</style>

<div class="container py-4">
    <!-- Course Header -->
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                </ol>
            </nav>
        </div>
    </div>

    <!-- Course Content -->
    <div class="row">
        <!-- Main Content Column -->
        <div class="col-lg-8">

            <!-- News Image -->
            <img src="@Model.ImageURL" alt="@Model.Title" class="news-image" />

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h1 class="card-title">@Model.Title</h1>
                    </div>
                    <hr class="my-4">

                    <!--<h3-- class="card-subtitle mb-3">Съдържание</h3-->
                    <div class="card-text course-content mb-4">
                        @Html.Raw(Model.Content)
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- User Actions -->
            <div class="card shadow-sm mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Действия</h4>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Index" asp-controller="Home"
                           class="btn btn-outline-primary">
                            <i class="bi bi-flag me-2"></i>Върнете се обратно към новините
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
