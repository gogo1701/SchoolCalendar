@model News
<style>
    .form-section {
        margin-bottom: 2rem;
    }

    .form-label {
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .help-text {
        color: #6c757d;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .tox-tinymce {
        border-radius: 0.375rem !important;
    }

    .form-card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .page-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid #dee2e6;
        padding-bottom: 1rem;
    }
</style>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h2 mb-1">Нова новина</h1>
                    <p class="text-muted">Публикувайте нова новина</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Обратно към новини
                </a>
            </div>

            <!-- Form Card -->
            <div class="card form-card">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" class="needs-validation" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Basic Information Section -->
                        <div class="form-section">
                            <h3 class="h5 mb-3">Основна информация</h3>
                            <div class="mb-3">
                                <label asp-for="Title" class="form-label">Заглавие <span class="text-danger">*</span></label>
                                <input asp-for="Title" class="form-control form-control-lg" required />
                                <span asp-validation-for="Title" class="text-danger"></span>
                                <div class="help-text">Заглавие на новината</div>
                            </div>                            
                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">Описание <span class="text-danger">*</span></label>
                                <input asp-for="Description" class="form-control form-control-lg" required />
                                <span asp-validation-for="Description" class="text-danger"></span>
                                <div class="help-text">Описание, което ще се показва на главната страница</div>
                            </div>
                        </div>
                        
                        <!-- Basic Information Section -->
                        <div class="form-section">
                            <h3 class="h5 mb-3">Материали</h3>
                            <div class="mb-3">
                                <label asp-for="ImageURL" class="form-label">URL на снимка <span class="text-danger">*</span></label>
                                <input asp-for="ImageURL" class="form-control form-control-lg" required />
                                <span asp-validation-for="ImageURL" class="text-danger"></span>
                                <div class="help-text">URL на снимка</div>
                            </div>
                        </div>

                        <div class="form-section">
                            <h3 class="h5 mb-3">Дати</h3>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="DateOnCalendar" class="form-label">Дата на календар</label>
                                    <input asp-for="DateOnCalendar" type="date" class="form-control" />
                                    <span asp-validation-for="DateOnCalendar" class="text-danger"></span>
                                    <div class="help-text">Датата, на която да се изписва новината в календара. (Ако не искате да се появява на календара, не слагайте нищо)</div>
                                </div>
                            </div>
                        </div>

                        <!-- Content Section -->
                        <div class="form-section">
                            <h3 class="h5 mb-3">Съдържание</h3>

                            <div class="mb-3">
                                <label asp-for="Content" class="form-label">Съдържание <span class="text-danger">*</span></label>
                                <textarea asp-for="Content" id="tiny" class="form-control" rows="15" required></textarea>
                                <span asp-validation-for="Content" class="text-danger"></span>
                                <div class="help-text">Съдържание</div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="form-section border-top pt-4">
                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-outline-secondary" onclick="window.history.back();">
                                    Откажи
                                </button>
                                <div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-check-circle me-1"></i> Изпрати
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof tinymce !== 'undefined') {
                tinymce.init({
                    selector: '#tiny',
                    height: 500,
                    plugins: 'anchor autolink charmap codesample emoticons image link lists media searchreplace table visualblocks wordcount',
                    toolbar: 'undo redo | blocks fontfamily fontsize | bold italic underline strikethrough | link image media table | align lineheight | numlist bullist indent outdent | emoticons charmap | removeformat',
                });
            }

            const form = document.querySelector('form');
            form.addEventListener('submit', function (event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}