<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>News & Calendar Page</title>
    <style>
        body {
            background-color: #f8f9fa;
        }

        .calendar {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 15px;
            background: #fff;
        }

        .calendar table {
            width: 100%;
            text-align: center;
        }

        .calendar th {
            color: #495057;
        }

        .calendar td {
            height: 80px;
            vertical-align: top;
            cursor: pointer;
        }

        .calendar .today {
            background-color: #e9f7ef;
            border-radius: 5px;
        }

        .calendar .event {
            background-color: #d1ecf1;
            border-radius: 5px;
        }

        .event-details {
            margin-top: 10px;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background: #fff;
        }

        .card-img-top {
            height: 150px;
            object-fit: cover;
        }
    </style>
</head>

<body>
    <div class="container-fluid mt-4">
        <div class="row">
            <div class="col-lg-8">
                <div class="row row-cols-1 g-4">
                    @foreach (var item in Model.News)
                    {
                        <div class="col">
                            <div class="card h-100">
                                <img src="@item.ImageURL" class="card-img-top" alt="@item.Title" />
                                <div class="card-body">
                                    <h5 class="card-title">@item.Title</h5>
                                    <p class="card-text">@item.Description</p>
                                </div>
                                <div class="card-footer d-flex justify-content-between">
                                    <small class="text-muted">Дата: @item.DatePublished.ToShortDateString()</small>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Повече информация</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                <nav aria-label="News pagination" class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">Назад</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">Напред</a>
                        </li>
                    </ul>
                </nav>
            </div>

            <!-- Right side: Calendar -->
            <div class="col-lg-4">
                <div class="calendar">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <button id="prevMonth" class="btn btn-sm btn-outline-primary">&lt;</button>
                        <h5 id="monthYear" class="mb-0"></h5>
                        <button id="nextMonth" class="btn btn-sm btn-outline-primary">&gt;</button>
                    </div>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Sun</th>
                                <th>Mon</th>
                                <th>Tue</th>
                                <th>Wed</th>
                                <th>Thu</th>
                                <th>Fri</th>
                                <th>Sat</th>
                            </tr>
                        </thead>
                        <tbody id="calendarBody"></tbody>
                    </table>
                    <div id="eventDetails" class="event-details d-none">
                        <h6>Детайли за новини</h6>
                        <p id="eventText">Няма новина избрана</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const calendarBody = document.getElementById("calendarBody");
        const monthYear = document.getElementById("monthYear");
        const eventDetails = document.getElementById("eventDetails");
        const eventText = document.getElementById("eventText");

        let currentDate = new Date();
        let events = {}; 

        async function loadEvents() {
            try {
                const res = await fetch("/api");
                const data = await res.json();

                events = {};
                data.forEach(e => {
                    const dateKey = e.calendarDate.split("T")[0];
                    if (!events[dateKey]) events[dateKey] = [];
                    events[dateKey].push({
                        title: e.title,
                        description: e.description
                    });
                });

                renderCalendar(currentDate);
            } catch (err) {
                console.error("Имаше грешка при взимането на новини:", err);
            }
        }

        function renderCalendar(date) {
            calendarBody.innerHTML = "";
            const year = date.getFullYear();
            const month = date.getMonth();

            monthYear.textContent = date.toLocaleString("default", { month: "long", year: "numeric" });

            const firstDay = new Date(year, month, 1).getDay();
            const daysInMonth = new Date(year, month + 1, 0).getDate();

            let row = document.createElement("tr");
            for (let i = 0; i < firstDay; i++) {
                row.appendChild(document.createElement("td"));
            }

            for (let day = 1; day <= daysInMonth; day++) {
                if ((row.children.length) % 7 === 0) {
                    calendarBody.appendChild(row);
                    row = document.createElement("tr");
                }
                const cell = document.createElement("td");
                const fullDate = `${year}-${String(month + 1).padStart(2, "0")}-${String(day).padStart(2, "0")}`;

                cell.textContent = day;

                if (new Date().toDateString() === new Date(year, month, day).toDateString()) {
                    cell.classList.add("today");
                }

                cell.addEventListener("click", () => {
                    eventDetails.classList.remove("d-none");
                    if (events[fullDate]) {
                        eventText.innerHTML = events[fullDate]
                            .map(ev => `<strong>${ev.title}</strong>`)
                            .join("<br>");
                    } else {
                        eventText.textContent = "Няма новини за тази дата.";
                    }
                });

                if (events[fullDate]) {
                    cell.classList.add("event");
                }

                row.appendChild(cell);
            }
            calendarBody.appendChild(row);
        }

        document.getElementById("prevMonth").addEventListener("click", () => {
            currentDate.setMonth(currentDate.getMonth() - 1);
            renderCalendar(currentDate);
        });

        document.getElementById("nextMonth").addEventListener("click", () => {
            currentDate.setMonth(currentDate.getMonth() + 1);
            renderCalendar(currentDate);
        });

        loadEvents();
    </script>

</body>

</html>